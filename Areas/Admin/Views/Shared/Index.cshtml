@{
    ViewData["Title"] = "Admin Dashboard";
    var loanTable = Url.Action("LoanTable", "Loan", new { area = "Admin" });
    var paymentTable = Url.Action("PaymentTable", "Payment", new { area = "Admin" });
}

<!-- Link External CSS -->
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<!-- Include Dropdown for Administrative -->
@await Html.PartialAsync("_AdminHeader")


<!-- Dashboard Layout -->
<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <button class="active">HOME</button>
        <button href="@Url.Action("MemberList", "Admin")" class="members-btn">MEMBERS</button>
        <button id="loans-btn">LOANS</button>
        <button id="payment-btn">PAYMENTS</button>
        <button>USER</button>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <h1 class="welcome-text">Welcome to the Admin Dashboard</h1>
        <section class="grid-content">
            <div class="grid-item">MEMBER</div>
            <div class="grid-item">CONTRIBUTION</div>
            <div class="grid-item">MONEY ON HAND</div>
            <div class="grid-item">PAYMENT RECEIVED</div>
            <div class="grid-item">BALANCE TO COLLECT</div>
            <div class="grid-item">LEND MONEY</div>
            <div class="grid-item">REPORTS</div>
            <div class="grid-item">ACTIVE LOANS</div>
            <div class="grid-item">APPROVED LOAN</div>
        </section>
    </main>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $(".members-btn").click(function() {
            window.location.href = "@Url.Action("MemberList", "Admin")";
        });
        // Redirect to Loan Table when clicking Loans Button
        $("#loans-btn").click(function() {
            window.location.href = "@loanTable";
        });
        // Redirect to Loan Table when clicking Loans Button
        $("#payment-btn").click(function() {
            window.location.href = "@paymentTable";
        });
    });
</script>
