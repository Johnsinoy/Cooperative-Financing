@model List<CooperativeFinancing.Models.CooperativeLoans>

@{
    var loanTable = Url.Action("LoanTable", "Loan", new { area = "Admin" });
    var paymentTable = Url.Action("PaymentTable", "Payment", new { area = "Admin" });
    var userTable = Url.Action("UserTable", "User", new { area = "Admin" });
    var updateLoanUrl = Url.Action("UpdateLoan", "Loan", new { area = "Admin" });
    var deleteLoanUrl = Url.Action("DeleteLoan", "Loan", new { area = "Admin" });
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/table-list.css" asp-append-version="true" />

<!-- Include Dropdown for Administrative -->
@await Html.PartialAsync("_AdminHeader")

<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <button onclick="window.location.href='@Url.Action("Index", "Admin")'">HOME</button>
        <button id="members-btn">MEMBERS</button>
        <button id="loans-btn" class="active">LOANS</button>
        <button id="payment-btn">PAYMENTS</button>
        <button id="usertable-btn">USER</button>
    </aside>

    <main class="main-content">
        <table class="member-table">
            <thead>
                <tr>
                    <th>Loan ID</th>
                    <th>Member ID</th>
                    <th>Loan Amount</th>
                    <th>Purpose</th>
                    <th>Annual Interest</th>
                    <th>Term (Months)</th>
                    <th>Release Date</th>
                    <th>First Month</th>
                    <th>End Month</th>
                    <th>Monthly Payment</th>
                    <th>Total Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr id="loan-row-@loan.Loan_Id">
                        <td>@loan.Loan_Id</td>
                        <td>@loan.Member_Id</td>
                        <td>@loan.Loan_Amount.ToString("C")</td>
                        <td>@loan.Purpose_Loan</td>
                        <td>@loan.Annual_Interest %</td>
                        <td>@loan.Term</td>
                        <td>@loan.Release_Date.ToString("yyyy-MM-dd")</td>
                        <td>@loan.First_Month.ToString("yyyy-MM-dd")</td>
                        <td>@loan.End_Month.ToString("yyyy-MM-dd")</td>
                        <td>@loan.Monthly_Payment.ToString("C")</td>
                        <td>@loan.Total_Payment.ToString("C")</td>
                        <td class="status">@loan.Status</td>
                        <td>
                            <button class="edit-btn" data-loan-id="@loan.Loan_Id">Edit</button>
                            <button class="delete-btn" data-loan-id="@loan.Loan_Id">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</div>

<!-- Edit Loan Modal -->
<div id="editLoanModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeEditModal()">&times;</span>
        <h2>Edit Loan</h2>
        <form id="editLoanForm">
            <label>Loan ID:</label>
            <input type="text" id="editLoanId" readonly>

            <label>Loan Amount:</label>
            <input type="number" id="editLoanAmount" required>

            <label>Purpose:</label>
            <input type="text" id="editLoanPurpose" required>

            <label>Term (Months):</label>
            <select id="editLoanTerm">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="36">36</option>
            </select>

            <label>Status:</label>
            <select id="editLoanStatus">
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Active">Active</option>
                <option value="Paid">Paid</option>
            </select>

            <button type="submit">Save Changes</button>
        </form>
    </div>
</div>

<!-- Delete Loan Modal -->
<div id="deleteLoanModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeDeleteModal()">&times;</span>
        <h2>Confirm Delete</h2>
        <p>Are you sure you want to delete this loan?</p>
        <button id="confirmDeleteLoan">Yes, Delete</button>
        <button onclick="closeDeleteModal()">Cancel</button>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        let selectedLoanId = null;

        // ✅ Open Edit Loan Modal
        $(document).on("click", ".edit-btn", function () {
            let row = $(this).closest("tr");
            let loanId = row.find("td:eq(0)").text().trim();
            let amount = row.find("td:eq(2)").text().replace(/[^0-9.]/g, "").trim();
            let purpose = row.find("td:eq(3)").text().trim();
            let term = row.find("td:eq(5)").text().trim();
            let status = row.find("td:eq(11)").text().trim();

            $("#editLoanId").val(loanId);
            $("#editLoanAmount").val(amount);
            $("#editLoanPurpose").val(purpose);
            $("#editLoanTerm").val(term);
            $("#editLoanStatus").val(status);

            $("#editLoanModal").show();
        });

        // ✅ Close Edit Modal
        function closeEditModal() {
            $("#editLoanModal").hide();
        }

        // ✅ Update Loan via AJAX
        $("#editLoanForm").submit(function (event) {
            event.preventDefault();
            let loanId = $("#editLoanId").val().trim();
            let loanAmount = $("#editLoanAmount").val();
            let purpose = $("#editLoanPurpose").val().trim();
            let term = $("#editLoanTerm").val();
            let status = $("#editLoanStatus").val();

            $.ajax({
                url: "@updateLoanUrl",
                type: "POST",
                data: { Loan_Id: loanId, Loan_Amount: loanAmount, Purpose_Loan: purpose, Term: term, Status: status },
                success: function () {
                    alert("✅ Loan updated successfully!");
                    location.reload();
                },
                error: function (xhr) {
                    alert("❌ Error updating loan: " + xhr.responseText);
                }
            });
        });

        // ✅ Open Delete Loan Modal
        $(document).on("click", ".delete-btn", function () {
            selectedLoanId = $(this).data("loan-id");
            $("#deleteLoanModal").show();
        });

        // ✅ Close Delete Modal
        function closeDeleteModal() {
            $("#deleteLoanModal").hide();
            selectedLoanId = null;
        }

        // ✅ Delete Loan via AJAX
        $("#confirmDeleteLoan").click(function () {
            $.ajax({
                url: "@deleteLoanUrl",
                type: "POST",
                data: { Loan_Id: selectedLoanId },
                success: function () {
                    alert("✅ Loan deleted successfully!");
                    location.reload();
                },
                error: function (xhr) {
                    alert("❌ Error deleting loan: " + xhr.responseText);
                }
            });
        });
    });
</script>
