@model List<CooperativeFinancing.Models.ViewModels.LoanViewModel>

@{
    var loanTable = Url.Action("LoanTable", "Loan", new { area = "Admin" });
    var paymentTable = Url.Action("PaymentTable", "Payment", new { area = "Admin" });
    var userTable = Url.Action("UserTable", "User", new { area = "Admin" });
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/table-list.css" asp-append-version="true" />

<!-- Include Dropdown for Administrative -->
@await Html.PartialAsync("_AdminHeader")


<div class="dashboard-container">

    <!-- Sidebar -->
    <aside class="sidebar">
        <button onclick="window.location.href='@Url.Action("Index", "Admin")'">HOME</button>
        <button id="members-btn">MEMBERS</button>
        <button id="loans-btn" class="active">LOANS</button>
        <button id="payment-btn">PAYMENTS</button>
        <button id="usertable-btn">USER</button>
    </aside>
    <main class="main-content">

        <table class="member-table">
            <thead>
                <tr>
                    <th>Member Name</th>
                    <th>Loan Amount</th>
                    <th>Purpose</th>
                    <th>Annual Interest</th>
                    <th>Term (Months)</th>
                    <th>Release Date</th>
                    <th>First Month</th>
                    <th>End Month</th>
                    <th>Monthly Payment</th>
                    <th>Total Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("MemberProfile", "Member", new { id = loan.Member_Id })">
                                @loan.FirstName @loan.LastName
                            </a>
                        </td>
                        <td>@loan.Loan_Amount.ToString("C")</td>
                        <td>@loan.Purpose_Loan</td>
                        <td>@loan.Annual_Interest %</td>
                        <td>@loan.Term</td>
                        <td>@loan.Release_Date.ToString("yyyy-MM-dd")</td>
                        <td>@loan.First_Month.ToString("yyyy-MM-dd")</td>
                        <td>@loan.End_Month.ToString("yyyy-MM-dd")</td>
                        <td>@loan.Monthly_Payment.ToString("C")</td>
                        <td>@loan.Total_Payment.ToString("C")</td>
                        <td class="status">@loan.Status</td>
                        <td>
                            <button class="edit-btn" onclick="openEditModal(@loan.Member_Id)">Edit</button>
                            <button class="delete-btn" onclick="deleteLoan(@loan.Member_Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $("#members-btn").click(function() {
            window.location.href = "@Url.Action("MemberList", "Admin")";
        });
        // Redirect to Loan Table when clicking Loans Button
        $("#loans-btn").click(function() {
            window.location.href = "@loanTable";
        });
        // Redirect to Loan Table when clicking Loans Button
        $("#payment-btn").click(function() {
            window.location.href = "@paymentTable";
        });
        // Redirect to Loan Table when clicking Loans Button
        $("#usertable-btn").click(function() {
            window.location.href = "@userTable";
        });
    });
</script>

